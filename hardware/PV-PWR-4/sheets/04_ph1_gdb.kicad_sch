	)
	(text "P1S4: DRIVER AND 2 GATES"
		(exclude_from_sim no)
		(at 14 248.78 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "0cc65c63-8669-54b4-94f2-358443b404f5")
	)
	(text "MMBT3906 inverter (E COM, base BAT54+2.2k on CLAMP) drives CG to COM once the lowest gate is below ~-1.2 V;\nMMBT3904 release (from OUTH via 5.6 V Zener) holds CG at VEE while OUTH drives."
		(exclude_from_sim no)
		(at 376.487 112.648 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "0d1d7f78-f484-528b-a638-35a4a5e973ad")
	)
	(text "Gate and Kelvin of each device as coupled pairs of equal length (+/-10 %) from the COM star; Ron, Roff, Kelvin\nR, 10k, Zeners at each device. Clamp FET + C_VL at its device's gate-Kelvin pins, loop <= 1 nH. DESAT string\n>= 2.5 mm pad gap per diode; board coated to PD1 (IC-22). Miller hold (ngspice, gdrv): die +1.41 V vs VGS(th)\nmin 1.94 V at 175 C - BENCH TEST. Driver input side and bias primary decoupled to GND locally (CM current)."
		(exclude_from_sim no)
		(at 14 403.68 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "3b4dc0d0-63e0-570a-8b1d-4d300bcd48f4")
	)
	(text "IN+ = own PWM; IN- = complementary switch, falling edge stretched 4.02k/100p\n(interlock + min dead time = max(firmware, hardware)). Bias PG (active low) pulls RDY low."
		(exclude_from_sim no)
		(at 244.85 236.28 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "4e09d3e3-4ca5-50e4-84db-bd58a5853e43")
	)
	(text "Per device: Ron/Roff, 0.5R Kelvin R to the COM star, 10k and Zeners (about +21 V / -5.7 V) on its own Kelvin net.\nMiller hold: N-MOSFET clamp (PMV30ENEA) gate-pin to a local VEE (1u on the Kelvin pin). LAYOUT: FET + 1u at the device, loop <= 1 nH."
		(exclude_from_sim no)
		(at 189.98 140.9 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "4fd567f4-cf16-5d55-8432-db0d37c1ec17")
	)
	(text "P1S4: DESAT"
		(exclude_from_sim no)
		(at 432.655 248.78 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "54cea4b4-824b-56e8-bbf6-11af7466adf7")
	)
