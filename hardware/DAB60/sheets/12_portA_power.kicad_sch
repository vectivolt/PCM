			)
			(justify left bottom)
		)
		(uuid "48a23c29-371e-56aa-ba77-584ef2ebac79")
	)
	(text "X 2 x 2.2 uF film (RFQ: impulse >= 4.5 kV, PA-07), CM choke (CUSTOM), Y1 4.7 nF pole-PE\n(1500 VDC rated). Y capacitors are declared HV-PE crossings."
		(exclude_from_sim no)
		(at 248.516 76.32 0)
		(effects
