	)
	(text "Cathode (2) to DC+, anode (1) to DC- at the bank terminals; terminal 3 unused. Reverse-biased in operation.\nPort short: carries 15.7 kA / 16.5 kA2s after the bank reverses (I2t 1.8 MA2s) instead of the module body\ndiodes. CHASSIS-MOUNTED, insulated base plate (basic, to PE frame)."
		(exclude_from_sim no)
		(at 324.528 51.26 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "e6b589bb-338f-5377-bfd0-223369e912f5")
	)
	(text "Switch 1/2 = leg A (AC1), 3/4 = leg B (AC2). Kelvin sources S1-S4 go to the drivers only (COM).\nNTC T1/T2 is read by the switch-2 driver (AIN referenced to S2), as on the CRD. Drains of 1/3 = DC+."
		(exclude_from_sim no)
		(at 14 94.38 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
