		(uuid "39eeaf3a-1c61-50b0-9cec-b75e1bb0e2d9")
	)
	(text "VDDIO 4 x 100 nF (>= 0.1 uF per pin); VDDA 2.2 uF + 100 nF behind a 300 R bead (pi filter allowed by\n6.12.1.4.1); VDD 2 x 10 uF + 2 x 100 nF = 20.2 uF (10-26.8 uF total, internal VREG, 10 % parts)."
		(exclude_from_sim no)
		(at 284 83.3 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "3c13aae6-59e8-5d08-b5e7-17ce5697b4f1")
	)
	(text "Pins as gen/data/pv_ctrl_pin_plan.csv (checked against SPRSP61C table 5-1 on every\nbuild). VREGENZ = GND: internal 1.2 V VREG; VDD only decoupled."
