	)
	(text "TPSI3050 EN = K_DISCH OR FB_B_MAIN (2 x BAS16): powered = BSS138 holds the SiC gate low. Unpowered\n= the bus biases the gate (10 M, 15 V zener) -> 2 x 300 ohm Miba RST 200 discharge the bus. FB is high\nwhile the contactor is closed (or welded), so an E-stop or a lost K_DISCH cannot discharge a live port;\nFB keeps a running TPSI on, SYS energises K_DISCH first at power-up (27 mA start-up)."
		(exclude_from_sim no)
		(at 14 347.484 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "c1e27ea5-27f0-563d-977e-b3bf82c43a84")
	)
