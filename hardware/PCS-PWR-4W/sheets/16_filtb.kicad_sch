		(uuid "861d91c6-c3f8-5875-8115-d8631b0ddf96")
	)
	(text "Board studs (REDCUBE press-fit, 100 A each): 3 x switch node to L1, 3 x L1 out (C_f node, its busbar through the\nsensor), 3 x C_f node to L2, 3 x L2 out (to AC contactor K1 on the port sheet). Cores bonded to PE."
		(exclude_from_sim no)
		(at 14 76.02 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "a9110afd-5052-52f3-a632-267129d1fe05")
	)
