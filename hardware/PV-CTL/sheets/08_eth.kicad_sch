	)
	(text "Port 1 (RXD1 / TXD1) to SCIB through the CA-IS3842HW (sheet 06); port 2, CTS, TNOW open. 25 MHz 12 pF crystal, no\nload C (inside); VDDK 1 uF; power-on reset inside. Straps (pull-ups inside): CFG low at power-up = serial set-up\n(end-of-line test point); LINK/RESET low for 2 s = factory reset - its LED path holds it high. UART 1.0k / 2.0k."
		(exclude_from_sim no)
		(at 144.472 93.344 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
