	)
	(text "Feeds: 121k / 10k -> full scale 32.7 V (CH12 feed 1, CH13 feed 2, CH14 AUX-HV).\nCH15: IMON_GD 27.9 uA/A x 14.7k -> 6 A = 2.46 V (gate-drive bias of all power boards)."
		(exclude_from_sim no)
		(at 244.288 196.124 0)
		(effects
