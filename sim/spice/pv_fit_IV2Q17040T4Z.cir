* PVCELL VDMOS C_gd fit for IV2Q17040T4Z: drain ramp 0..1000 V, gate held at -3.5 V
.model m VDMOS(Vto=3.1 Kp=5 lambda=0.01 Rd=0.02558 Rs=0.5m Rg=2.2 Cgs=3.42e-09 Cgdmax=6.86e-10 Cgdmin=9.75e-12 a=0.01968 Cjo=1.888e-09 Vj=3 M=0.5 Is=7.58e-16 N=3 Rb=0.07054 Tt=0)
Vg g 0 -3.5
Vd dd 0 PWL(0 0 10u 1000.0)
Rd dd dn 1m
M1 dn g 0 m
.save i(Vg) v(dn)
.tran 5n 10u
.control
run
wrdata pv_fit_IV2Q17040T4Z.dat i(Vg) v(dn)
quit
.endc
.end
