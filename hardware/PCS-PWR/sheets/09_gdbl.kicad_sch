	(text "BL: DESAT"
		(exclude_from_sim no)
		(at 14 182.792 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "03d00b8c-28a4-5410-b1d3-65010182caef")
	)
	(text "Per device: Ron/Roff, 0.5R Kelvin R to the COM star, 10k and Zeners (about +21 V / -5.7 V) on its own Kelvin net.\nMiller hold: N-MOSFET clamp (PMV30ENEA) gate-pin to a local VEE (1u on the Kelvin pin). LAYOUT: FET + 1u at the device, loop <= 1 nH."
		(exclude_from_sim no)
		(at 134.536 170.292 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "2907a08e-0918-5af9-815f-6c081f0b2232")
	)
	(text "BL: LOGIC SIDE"
		(exclude_from_sim no)
		(at 14 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "38ea1d51-ab88-57f7-a300-022bfa0e10a7")
	)
	(text "IN+ = own PWM; IN- = complementary switch, falling edge stretched 3.65k/100p\n(interlock + min dead time = max(firmware, hardware)). Bias PG (active low) pulls RDY low."
		(exclude_from_sim no)
		(at 14 107.7 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "4051fc7e-bde4-5fd4-99db-23718e2e3531")
	)
	(text "DESAT pin (internal 500 uA blanking source, trip 8.5-10.0 V) - Rs - 2 x US1M - drain.\nBAT54S keeps DX between COM and VDD against dv/dt through the string; Cblk footprint DNP."
		(exclude_from_sim no)
		(at 14 251.772 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "8f03da9b-c5ec-59d7-b897-fa5a4dcdd2f4")
	)
	(text "BL: SHORT-CIRCUIT BOOSTER"
		(exclude_from_sim no)
		(at 660.3058 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a4b44312-fca3-5ad1-a5ea-551957ba2e69")
	)
	(text "2 x ZXTP25040DFH emitter followers on OUTL (B-E 1k, C to VEE): each sinks the Roff current of 3 gates;\nthe NSI6651 supplies base current only. Turn-on stays on OUTH."
		(exclude_from_sim no)
		(at 443.463 71.252 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "ae6890cf-b143-54dd-b74d-5e5f0dc93b9e")
	)
	(text "BL: DRIVER AND 6 GATES"
