	(text "Gate and Kelvin of each device as coupled pairs of equal length from the COM star; Ron, Roff, Kelvin R, 10k + 1n,\nZeners and the clamp FET + C_VL at each device (loop <= 1 nH). PNP followers next to their three gates. DESAT\nstring >= 2.5 mm pad gap per diode; coat to PD1. Miller hold of six gates NOT simulated - BENCH TEST."
		(exclude_from_sim no)
		(at 14 306.856 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "00dbcb91-eb9b-58b1-8df3-8e8da6ad4476")
	)
	(text "AL: LOGIC SIDE"
		(exclude_from_sim no)
		(at 14 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "0c4785e8-b89b-56ce-b0b1-4559b1602ea6")
	)
	(text "AL: DRIVER AND 6 GATES"
		(exclude_from_sim no)
		(at 134.536 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "16d119d5-56be-51b3-b5c2-de25e70ebd38")
	)
	(text "AL: SHORT-CIRCUIT BOOSTER"
		(exclude_from_sim no)
		(at 660.3058 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
