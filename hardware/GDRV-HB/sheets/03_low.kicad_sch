	(text "L: DRIVER AND GATE"
		(exclude_from_sim no)
		(at 14 143.608 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "037f8f0c-e56f-52eb-a74f-77d703934fe7")
	)
	(text "L: DESAT"
		(exclude_from_sim no)
		(at 280.22 143.608 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "140213a3-4a72-58ce-80fe-488bde7f76ca")
	)
	(text "L: MODULE PINS"
		(exclude_from_sim no)
		(at 14 242.556 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "51098ab3-b220-5c73-ab75-1a1acfe808c8")
	)
	(text "NSI6651ASC CLAMP direct to the gate (active Miller clamp). Kelvin = COM.\nZener pair clamps the gate to about +17 V / -6.6 V when the driver cannot."
		(exclude_from_sim no)
		(at 14 230.056 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "784919b4-dd16-5f71-bbe2-a28071fc649c")
	)
	(text "IN+ = own PWM; IN- = complementary switch, falling edge stretched 2.37k/100p\n(interlock + min dead time = max(firmware, hardware)). Bias PG (active low) pulls RDY low."
		(exclude_from_sim no)
		(at 14 96.36 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "7d2b619e-01ff-5816-9aeb-3f7145b213f4")
	)
	(text "UCC14241-Q1, 24 V in, regulated +/-1.3 %, reinforced barrier.\nRDR: RLIM1 sources COM, RLIM2 + DLIM sink it."
		(exclude_from_sim no)
		(at 153.869 131.108 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "80dc4258-bff4-5467-b3de-51129afc2eee")
	)
	(text "DESAT pin (internal 500 uA blanking source, trip 8.5-10.0 V) - Rs - 3 x US1M - drain.\nBAT54S keeps DX between COM and VDD against dv/dt through the string; Cblk footprint DNP."
		(exclude_from_sim no)
		(at 280.22 198.928 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "8416e8da-4350-57de-8345-d68a119781f0")
	)
	(text "DESAT > 10.3-10.9 V (above the 10.0 V maximum trip of the -Q1 grade) -> MMBT3904 -> MMBT3906 charges BG to VEE + 10 V;\nper device AO3400A + 15R pull the gate to VEE; BG holds ~3 us (1k + FET gates)."
		(exclude_from_sim no)
		(at 159.592 205.32 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "8efa2f9f-bd66-5677-b5be-e17f80f6051b")
	)
	(text "L: SHORT-CIRCUIT BOOSTER"
		(exclude_from_sim no)
		(at 159.592 143.608 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "af8d19b1-564f-5f4f-9252-54496841565f")
	)
	(text "L: ISOLATED BIAS +15 V / -4 V"
		(exclude_from_sim no)
		(at 153.869 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b3a1e451-7afb-5be9-8edb-4e6741c27078")
	)
	(text "Solder pins to the power board under the module: G/KS interleaved. The module\nNTC is NOT on this card: plain analog line to the CELL AN2/AN3 on the power board. Drain sense on its own pin (module AC (switch node)), spaced for 1000 V."
		(exclude_from_sim no)
		(at 14 267.216 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "e16f663b-a7f0-5ac6-9bfd-849ef5b0a16d")
	)
