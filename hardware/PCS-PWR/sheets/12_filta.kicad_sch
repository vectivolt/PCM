	(text "IL1 = Vref + G x I (I + = L1 -> C_f), IL1R = its Vref: 100R + 1 nF each at the source (as PV-PWR).\nThe primary sits between L1 and the C_f node (a 50 Hz-smooth node, not the switch node)."
		(exclude_from_sim no)
		(at 149.364 68.192 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "825b5b22-7f4b-5397-8406-9fea2e8731c5")
	)
	(text "Board studs (REDCUBE press-fit, 100 A each): 3 x switch node to L1, 3 x L1 out, 3 x C_f node to L2,\n3 x L2 out (to AC contactor K1 on the port sheet). Cores bonded to PE."
		(exclude_from_sim no)
		(at 14 76.02 0)
