		(uuid "1a9b7413-7580-5ec1-80aa-668737854932")
	)
	(text "DISCHARGE TIME LIMIT + THERMAL CUT-OFF (HV SIDE, NEEDS NO 24 V)"
		(exclude_from_sim no)
		(at 14 257.844 0)
		(effects
