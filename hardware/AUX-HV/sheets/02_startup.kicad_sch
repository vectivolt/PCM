	(text "INPUT OV LOCKOUT AND OVERLOAD TIMER (TLV3202 ON VREF, 2.5 V REFERENCE)"
		(exclude_from_sim no)
		(at 150.76 96.66 0)
		(effects
			(font
				(size 1.8 1.8)
