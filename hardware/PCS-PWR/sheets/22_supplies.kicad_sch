	(text "+3V3 DISCHARGE (RAMP-DOWN WHEN THE RAILS FAIL)"
		(exclude_from_sim no)
		(at 209.824 170.08 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "01422ffa-3676-5ed2-8376-c395abdf08b9")
	)
	(text "gate bias of legs b and c, +3V3 (TPS62130). ctrl_c2000 circuit (SNVSC40E table 9-1, 400 kHz / 5 V / 2 A): 15 uH, 3 x 22 uF, RT 64.9k,\nFB 100k / 24.9k 0.1 % -> 4.93-5.10 V. Load in design_check (<= 80 % of 2 A)."
		(exclude_from_sim no)
		(at 14 157.58 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "0e273c09-28ec-5f0b-9ece-8cdf83712744")
	)
	(text "TPS3710 107k/10k as on +5V: RDY low while the bias rail of phases 3 is below 4.52-4.69 V."
		(exclude_from_sim no)
		(at 209.42 146.612 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "360a64e1-5ef6-5c26-836c-4a85bbf2f572")
	)
	(text "AUX-T1 reinforced winding SELV_24V / SELV_0V, cross-regulated 20.3-29.8 V (aux75_spec); full fan speed needs\n24.5 V. Full fan speed is only guaranteed while the converter is switching. Fan buck (12-36 V in) + SELV logic on the control board;\n>= 10 mm from live copper; nothing else of the SELV domain is on this board."
		(exclude_from_sim no)
		(at 14 260.22 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "3610e0f8-a57a-5a31-9552-bc9da4e93c39")
	)
	(text "24 V -> +5V_GD (LMR38020, 400 KHZ, 2 A)"
		(exclude_from_sim no)
		(at 14 98.12 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "3c93fff2-ca4a-5762-8960-1025d9f51fe3")
	)
	(text "EN = PG_5VG. FB 31.6k / 10k 0.1 % -> 3.240-3.433 V (>= 3.20 V for the control board's reference). SS/TR 470p C0G:\nramp-up 12-16 mV/us (F28003x VDDIO 8-100 mV/us). Ports' logic, RDY / MOV_OK pull-ups, PC +3V3 (control <= 157 mA)."
		(exclude_from_sim no)
		(at 14 225.14 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "4a003dd3-1faf-515f-b1ef-9858db006576")
	)
	(text "24 V -> +5V (LMR38020, 400 KHZ, 2 A)"
		(exclude_from_sim no)
		(at 14 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "4bc8fbb2-196a-50ed-8fd6-0947ef0b252e")
	)
	(text "+5V_GD -> +3V3 (TPS62130, 2.5 MHZ) WITH A CONTROLLED RAMP"
		(exclude_from_sim no)
		(at 14 170.08 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "4dd4b951-466c-5926-9940-05c8a65d8ba1")
	)
	(text "PG_5VG low (+5V_GD < 90-94 %, i.e. the live 24 V is gone) disables the TPS62130 and lets the 100k from +24V\n(10 V Zener) turn on PMV30ENEA + 1.2R: +3V3 falls at >= 20 mV/us through the BOR region (F28003x SRVDDIO-DN)."
		(exclude_from_sim no)
		(at 209.824 221.26 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "52336732-0c26-529e-8d4a-e6ebe4af64ca")
	)
