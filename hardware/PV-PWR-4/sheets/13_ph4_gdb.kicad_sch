	(text "DESAT pin (internal 500 uA blanking source, trip 8.5-10.0 V) - Rs - 2 x BYG23T-M3/TR (1300 V each) - drain.\nBAT54S keeps DX between COM and VDD against dv/dt through the string; Cblk footprint DNP."
		(exclude_from_sim no)
		(at 433.579 325.76 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "2029749f-4c72-52c0-9295-ec01a6330060")
	)
	(text "P4S4: DRIVER AND 2 GATES"
		(exclude_from_sim no)
		(at 14 249.62 0)
		(effects
			(font
