	)
	(text "Murata NCP15XH103F03RC, 10.0k from VREF; ADC only (fan law, derating)."
		(exclude_from_sim no)
		(at 270.376 154.172 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "afab4281-19cf-5a23-8bbf-d1b113666b5a")
	)
	(text "Feeds VREFHI (pins 24/25, >= 2.2 uF), VDAC (pin 16, >= 1 uF), the NTC biases, the IL offset and the\nthreshold ladders of sheet 04: ADC, CMPSS and hardware trips are ratiometric to one reference. It runs\nfrom VDDA, so it never sits above VDDA (SPRSP61C 6.12.1.4.2). Needs +3V3 >= 3.20 V (REF30E dropout)."
		(exclude_from_sim no)
		(at 14 59.4 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "b3135984-fe58-58f0-8f54-3c67b18329b6")
	)
