* PVCELL VDMOS C_gd fit for SG2M040170HJ: drain ramp 0..1200 V, gate held at -3.5 V
.model m VDMOS(Vto=3.1 Kp=6.961 lambda=0.01 Rd=0.02936 Rs=0.5m Rg=1.4 Cgs=2.589e-09 Cgdmax=5.188e-10 Cgdmin=5e-12 a=0.05444 Cjo=2.098e-09 Vj=3 M=0.5 Is=7.58e-16 N=3 Rb=0.0143 Tt=0)
Vg g 0 -3.5
Vd dd 0 PWL(0 0 10u 1200.0)
Rd dd dn 1m
M1 dn g 0 m
.save i(Vg) v(dn)
.tran 5n 10u
.control
run
wrdata pv_fit_SG2M040170HJ.dat i(Vg) v(dn)
quit
.endc
.end
