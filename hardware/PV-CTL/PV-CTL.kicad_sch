	)
	(text "Assembly option: the Ethernet bridge (sheet 08_eth) is NOT FITTED on PV-CTL / PV-CTL-P75 (DNP); fitted on PCS-CTL. Debug header in cJTAG mode only."
		(exclude_from_sim no)
		(at 20 240 0)
