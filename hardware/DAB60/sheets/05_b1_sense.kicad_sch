				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "dd40df9f-889d-5693-94b8-5bc998ff3b94")
	)
	(text "OVER-CURRENT WINDOW +/-210 A, LOCAL AND FAST (HV SIDE -> ISO7720F -> TRIP_N)"
