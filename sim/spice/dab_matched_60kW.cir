* DAB-D60 switching-level SPS deck "matched_60kW" - generated by sim/dab_design.py, do not edit
* V1=800 V V2=873 V n=0.9167 L=6.500 uH Lm=150 uH phi=25.570 deg tdead=150 ns Ron=7.86 mohm
* snubber per bridge 6 x (6.8 ohm + 2.20 nF); HF ceramics none
.subckt sic d s g cq=1n
S1 d s g 0 swm
D1 s d dbody
Cq d s Q='3.0346e-10*V(d,s) + 1.87616e-07*(pwr(1+max(V(d,s),0)/3.35871,0.244691)-1) + 1.3668e-08*min(V(d,s),0)'
.ends sic
.model swm sw(vt=0.5 vh=0.1 ron=0.00786 roff=1e8)
.model dbody d(is=1e-9 n=5 rs=0.025)
Vp1 p1 0 DC 800
Vs1 p1 p1a 0
Rs1 p1a k1 1m
Ck1 k1 0 135u
Lb1 k1 bt1 2.4e-08
Vtie1 bt1 bp1 0
Rsn1 bt1 sn1 1.13333
Csn1 sn1 0 1.32e-08
XS1 bp1 na g1 sic cq=9.6202e-10
XS2 na 0 g2 sic cq=9.6202e-10
XS3 bp1 nb g2 sic cq=9.6202e-10
XS4 nb 0 g1 sic cq=9.6202e-10
Vil na na1 0
Lk na1 nx 6.5e-06 IC=-87.4181
Lmag nx nb 0.00015 IC=-9.54521
Etr nx nxb nc nd 0.916667
Vtr nxb nb 0
Ftr nd nc Vtr 0.916667
Rg s0 0 1meg
Vp2 p2 s0 DC 872.727
Vs2 k2 p2a 0
Rs2 p2a p2 1m
Ck2 k2 s0 195u
Lb2 k2 bt2 2.4e-08
Vtie2 bt2 bp2 0
Rsn2 bt2 sn2 1.13333
Csn2 sn2 s0 1.32e-08
XS5 bp2 nc g5 sic cq=9.2552e-10
XS6 nc s0 g6 sic cq=9.2552e-10
XS7 bp2 nd g6 sic cq=9.2552e-10
XS8 nd s0 g5 sic cq=9.2552e-10
Vg1 g1 0 PULSE(0 1 1.5e-07 1e-09 1e-09 4.848e-06 1e-05)
Vg2 g2 0 PULSE(1 0 0 1e-09 1e-09 5.149e-06 1e-05)
Vg5 g5 0 PULSE(0 1 8.60272e-07 1e-09 1e-09 4.848e-06 1e-05)
Vg6 g6 0 PULSE(1 0 7.10272e-07 1e-09 1e-09 5.149e-06 1e-05)
.ic V(k1)=800 V(bt1)=800 V(bp1)=800 V(sn1)=800 V(p1a)=800 V(na)=0 V(nb)=800 V(k2)=872.727 V(bt2)=872.727 V(bp2)=872.727 V(sn2)=872.727 V(p2a)=872.727 V(nc)=0 V(nd)=872.727 V(nx)=0
.options method=gear reltol=1e-3 abstol=1e-6 vntol=1e-4 chgtol=1e-15 itl4=100
.tran 1e-09 0.00024 0.00019 1e-09 uic
.control
run
wrdata sim/out/dab_design/spice_matched_60kW.txt i(Vil) V(na,nb) V(nc,nd) V(bp1,na) V(na) V(bp2,nc) V(nc) i(Vs1) i(Vs2) V(g1) V(g5) V(bp1) V(bt1,sn1) V(bt2,sn2) V(bp2,s0) V(bt1) V(bt2,s0)
quit
.endc
.end
