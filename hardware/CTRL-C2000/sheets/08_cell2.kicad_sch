	(text "C2_AN2 -> ADCINC5"
		(exclude_from_sim no)
		(at 265.056 121.06 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a7cbe9cb-7c08-5a39-8c62-7f05aecd4b6f")
	)
	(text "Pin map = interfaces.CELL. Pins 1-2 carry +24V_GD only (gate-driver bias, channel B switched).\nNTC_N returns to AGND here; FLT/EN pairs go to the trip sheet."
		(exclude_from_sim no)
		(at 14 89.3 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "f5d2ed56-78e8-574f-ac41-57e4a1dee7a3")
	)
	(text "PWMk (1 = switch on) -> RS-422 pair, terminated on the power board. 10k pull-downs: ePWM balls are\ninputs without pull-up during reset/boot (table 6-6), so every gate command is 0 until firmware runs.\nG = C2_DRV_EN, G~ high: outputs high impedance unless CHB_OK, C2_EN_MCU and RDY are high (INT-15).\nePWM5-8 have high-resolution PWM: the dual-active bridge (phase shift at 100 kHz) must use ports C1 and\nC2, one bridge per port."
		(exclude_from_sim no)
		(at 262.176 108.56 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "faf5f53c-25bf-57f2-ae4f-d7f01e82b569")
	)
