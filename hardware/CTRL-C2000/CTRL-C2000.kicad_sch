	)
	(text "CHB_OK, MCU enable and RDY; EN readback on GPIO100-103. +24V_GD feeds only the cell eFuses."
		(exclude_from_sim no)
		(at 20 240 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "1cd3d3e5-a373-5378-956e-016fe8d76e00")
	)
	(text "Rev E0  |  2026-10-04  |  Schematics authored by Chinmoy Bhuyan  |  TMS320F28388D common controller for PV-P75/100/110 and DAB-D60"
		(exclude_from_sim no)
		(at 20 36 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "21f0db96-6f7f-5c87-9232-de8c3b7bdb42")
	)
	(text "SPRSP14E 7.10.1.5: 0.1 uF per VDDIO/VDD3VFL/VDDOSC ball, 2.2 uF per VDDA ball,\n~22 uF total on VDD + one 56 R load, 22 uF per VREFHI (16-bit mode)"
		(exclude_from_sim no)
		(at 310.5 54 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "288c9b62-aa56-5e10-a9b3-d22e8dad7d62")
	)
	(text "80-way SYS contract: +24 V logic, +24V_GD (channel B), CAN, SCI, SPI, I2C, DI/DO,\nfault latch, GATE_EN, CHB_OK, watchdog, reset, fans, Ethernet MDI + centre tap"
		(exclude_from_sim no)
		(at 310.5 142 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "36302f6d-1968-54ab-9723-64c3ac2b9272")
	)
	(text "cTI-20 JTAG, CM debug UART, 24LC256 calibration EEPROM (0x57), status LEDs,\nERRORSTS, 8-channel SDFM expansion header (ECO-02 / ECO-09)"
		(exclude_from_sim no)
		(at 118.5 186 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "4145f7b1-6dd6-520b-8a2d-d10a3e463bad")
	)
	(text "All 337 balls, pin table extracted from SPRSP14E (gen/data/f28388d_pins.csv);\nnet per ball from the pin plan (gen/data/ctrl_c2000_pin_plan.csv)"
		(exclude_from_sim no)
		(at 214.5 54 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "5643c0e2-3802-5f00-ae22-1b2c4d966f77")
	)
	(text "Rails: 24 V -> 5 V (LMR38020) -> 3.3 V (TPS62133); its PG enables 1.2 V (TPS62130) and 3.3 V analog (TPS7A2033), so VDDIO leads VDD and VDDA (SPRSP14E table 7-1). Three TPS3703 hold XRSn (windows on 3.3 V and 3.3 V analog, UV on 1.2 V), every tolerance corner asserted. REF5025E"
		(exclude_from_sim no)
		(at 20 244 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "5b21e6de-4b07-5605-a7fe-853cf3e02314")
	)
	(text "+24V -> LMR38020 5 V -> TPS62133 3.3 V; PG chain enables TPS62130 1.2 V\nand TPS7A2033 3.3 V analog (VDDIO first, then VDD and VDDA)"
		(exclude_from_sim no)
		(at 22.5 54 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "7452ef57-b715-5c39-a85e-576c568327d6")
	)
	(text "INPUTXBAR6 -> TRIP6. CMPSS reference = VDAC = REF5025E; firmware nulls each channel at zero input at start-up; trip bands in the pin plan, asserted against sim/out/pv_control/control_spec.json. EN pair = GATE_EN AND CHB_OK AND MCU enable (74LVC11A); line drivers on only with"
		(exclude_from_sim no)
		(at 20 236 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "7d9eb531-e6d8-531e-8dff-4259518ac0f3")
	)
	(text "CELL contract 2x20: 8 PWM RS-422 drivers, 3 dual-range analog inputs, RDY, ID,\nNTC; gate-driver supply +24V_GD through a 1.5 A eFuse (TPS26600)"
		(exclude_from_sim no)
		(at 22.5 142 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "844ff370-71cc-542a-86f9-a6f4e0f7802c")
	)
	(text "runs from the analog rail, so VREFHI and VDAC never exceed VDDA."
		(exclude_from_sim no)
		(at 20 248 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "8c37ac55-9e92-5066-928b-a51d38b25ad7")
	)
	(text "PORT contract 2x13: VA, VAX, VB, VBX, IA, IB, AUX1, AUX2 isolated-amplifier pairs,\nbiased open-safe, through difference amp + RC + clamp; ID; +24V out through an eFuse"
		(exclude_from_sim no)
		(at 214.5 142 0)
		(effects
