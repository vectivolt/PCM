		(uuid "0b7f644f-9d2e-57c5-b701-602e3803fbfe")
	)
	(text "DESAT pin (internal 500 uA blanking source, trip 8.5-9.8 V) - Rs - 3 x US1M - drain.\nBAT54S keeps DX between COM and VDD against dv/dt through the string; Cblk footprint DNP."
		(exclude_from_sim no)
		(at 229.12 385.712 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "0e5b3c3c-affd-5d7e-bb11-9d7e0c72d8b8")
	)
	(text "MMBT3906 inverter (E COM, base BAT54+2.2k on CLAMP) drives CG to COM once the lowest gate is below ~-1.2 V;\nMMBT3904 release (from OUTH via 5.6 V Zener) holds CG at VEE while OUTH drives."
		(exclude_from_sim no)
		(at 14 381.448 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "19a6bcc3-b400-52f2-b11b-6625b7f22397")
	)
	(text "MMBT3906 inverter (E COM, base BAT54+2.2k on CLAMP) drives CG to COM once the lowest gate is below ~-1.2 V;\nMMBT3904 release (from OUTH via 5.6 V Zener) holds CG at VEE while OUTH drives."
		(exclude_from_sim no)
