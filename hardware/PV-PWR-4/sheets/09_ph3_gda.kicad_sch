	(text "MMBT3906 inverter (E COM, base BAT54+2.2k on CLAMP) drives CG to COM once the lowest gate is below ~-1.2 V;\nMMBT3904 release (from OUTH via 5.6 V Zener) holds CG at VEE while OUTH drives."
		(exclude_from_sim no)
		(at 376.487 112.648 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "02648665-58dc-59f7-9fef-4d398c8100c2")
	)
	(text "DESAT > 10.3-10.9 V (above the 9.8 V maximum trip) -> MMBT3904 -> MMBT3906 charges BG to VEE + 10 V;\nper device AO3400A + 22R pull the gate to VEE; BG holds ~3 us (1k + FET gates)."
		(exclude_from_sim no)
		(at 14 243.824 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "13ee00c9-35ba-5d4e-ad27-07ed5861b01e")
	)
	(text "P3S1: DESAT"
		(exclude_from_sim no)
		(at 117.6 153.4 0)
		(effects
