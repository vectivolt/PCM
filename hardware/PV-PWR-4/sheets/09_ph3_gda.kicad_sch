	(text "DESAT pin (internal 500 uA blanking source, trip 8.5-9.8 V) - Rs - 3 x US1M - drain.\nBAT54S keeps DX between COM and VDD against dv/dt through the string; Cblk footprint DNP."
		(exclude_from_sim no)
		(at 229.12 385.712 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "3b8dac43-6225-5d9f-a98b-26aec3d9ec59")
	)
	(text "Per device: Ron/Roff, 0.5R Kelvin R to the COM star, 10k and Zeners (about +21 V / -5.7 V) on its own Kelvin net.\nMiller hold: N-MOSFET clamp (PMV30ENEA) gate-pin to a local VEE (1u on the Kelvin pin). LAYOUT: FET + 1u at the device, loop <= 1 nH."
		(exclude_from_sim no)
		(at 372.672 275.3 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
