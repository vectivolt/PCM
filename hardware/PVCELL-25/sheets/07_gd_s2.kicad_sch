	(text "DESAT > 10.3-10.9 V (above the 10.0 V maximum trip of the -Q1 grade) -> MMBT3904 -> MMBT3906 charges BG to VEE + 10 V;\nper device AO3400A + 22R pull the gate to VEE; BG holds ~3 us (1k + FET gates)."
		(exclude_from_sim no)
		(at 124.222 216.792 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "0bf89c10-b1b6-569c-bd39-ade96b3c19f0")
	)
	(text "Per device: Ron/Roff, 0.5R Kelvin R to the COM star, 10k and Zeners (about +21 V / -5.7 V) on its own Kelvin net.\nMiller hold: N-MOSFET clamp (PMV30ENEA) gate-pin to a local VEE (1u on the Kelvin pin). LAYOUT: FET + 1u at the device, loop <= 1 nH."
		(exclude_from_sim no)
		(at 306.057 140.9 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "0c8f5297-1fd2-596a-9279-568cccbeae9a")
	)
	(text "UCC14241-Q1, 24 V in, regulated +/-1.3 %, reinforced barrier.\nRDR: RLIM1 sources COM, RLIM2 + DLIM sink it."
		(exclude_from_sim no)
		(at 167.281 131.948 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "1da0deb4-3c98-5b54-81c2-686f58609f39")
	)
	(text "S2: MILLER CLAMP CONTROL"
		(exclude_from_sim no)
		(at 14 153.4 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "2e252468-aea8-57d0-8166-480d972474ac")
	)
	(text "S2: ISOLATED BIAS +18 V / -3.5 V"
		(exclude_from_sim no)
		(at 167.281 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "31990040-15ce-5757-a552-8f1f90a80ddf")
	)
	(text "S2: LAYOUT RULES + MILLER MARGIN"
		(exclude_from_sim no)
		(at 341.522 153.4 0)
		(effects
			(font
