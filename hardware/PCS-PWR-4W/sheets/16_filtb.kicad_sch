	(text "IL2 = Uref + 3.2 mV/A x I (I + = L1 -> C_f: body arrow, verify at incoming inspection), IL2R = its Uref pin; 100R + 1 nF\neach at the source (as PV-PWR). Primary = L1's output busbar through the aperture (a 50 Hz-smooth node, not the switch\nnode). OCD (open drain, 2.93 x I_PN = 732 A +/-10 %) not used: above both IL windows and the L1 limit."
		(exclude_from_sim no)
		(at 150.024 71.192 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "48de8814-30fc-540b-a526-9a8bf496e5d3")
	)
	(text "PHASE B: L1 AND L2 (CHASSIS, CUSTOM) AND THEIR STUDS"
