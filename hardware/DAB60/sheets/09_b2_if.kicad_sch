	)
	(text "FLT_OK high = healthy -> FLT_P high (CTRL receiver wired swapped: high = fault); unpowered = high-Z = FAULT\nat the CTRL's bias. RDY_L = wired-AND of the 4 UCC21710 RDY (VCC/VDD UVLO, 4.99k). CELL RDY is DRIVEN high by\nan LVC08 gate (RDY_L & UV_OK, 100R) - the CTRL pulls it down with 100k and tri-states its PWM/EN drivers\nwhile RDY is low (INT-15); no 3.3 V here = output low = not ready."
		(exclude_from_sim no)
		(at 398.844 85.612 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "d7f1d826-85da-5a42-9935-e72e8d392d65")
	)
