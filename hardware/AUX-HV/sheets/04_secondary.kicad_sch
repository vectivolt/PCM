	(text "ATL431 integrates (C_Z 47n); fast-lane: LED current up to 10.1 mA needed (R <= 1.74k), 60 mW at that current.\nfeed-forward to REF: no start-up / hand-over overshoot (max 23.20 V vs SYS OV 23.97 V) 33k + 39n. CNY65B collector pulls COMP on the primary."
		(exclude_from_sim no)
		(at 225.89 81.62 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "0422187f-f85c-58a3-8c4c-32fe5c395cdb")
	)
