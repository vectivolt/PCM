	(lib_symbols)
	(text "74LVC07 wired-AND of every trip source -> PRE_N -> 74LVC1G74 latch (no firmware);\nheartbeat monoflop; 74LVC08 gating of 16 PWM, EN, K_A, K_B, K_PRE, STATUS, FAN"
		(exclude_from_sim no)
