* PVCELL VDMOS C_gd fit for C3M0016120K: drain ramp 0..800 V, gate held at -4.0 V
.model m VDMOS(Vto=2.5 Kp=18.23 lambda=0.01 Rd=0.01061 Rs=0.5m Rg=2.6 Cgs=6.909e-09 Cgdmax=1.384e-09 Cgdmin=1.3e-11 a=0.04167 Cjo=3.986e-09 Vj=3 M=0.5 Is=7.58e-16 N=3 Rb=0.03535 Tt=0)
Vg g 0 -4.0
Vd dd 0 PWL(0 0 10u 800.0)
Rd dd dn 1m
M1 dn g 0 m
.save i(Vg) v(dn)
.tran 5n 10u
.control
run
wrdata pv_fit_C3M0016120K.dat i(Vg) v(dn)
quit
.endc
.end
