		)
		(uuid "9fb70f5e-96ee-5eea-acda-c24d5310311e")
	)
	(text "The tap's + rail feeds the aux through its own BYG10Y: the aux runs from the grid with the DC side dead\n(565-650 V rectified at 400-460 V AC, inside its 250 V..1000 V full-power range)."
		(exclude_from_sim no)
		(at 182.59 40.64 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "b18966a6-4997-54c8-8238-043067935a55")
	)
	(text "AC PRECHARGE: G7L-2A-X (DC, POLES IN SERIES, NORMAL POLARITY) + 220 OHM RPRE_AL FROM ACT_P TO DC+"
