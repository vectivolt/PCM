	(text "Die VGS of the OFF switch while its partner turns on: -0.55 V at 56.7 V/ns (dab_spec, I_M 2.0 A), +0.87 V\nat 80 V/ns (module max, 2.9 A) vs VGS(th) 1.44 V at 175 C: fine at the DAB rate, marginal at 80 V/ns\n(gdrv's own case, Roff 1 ohm: +1.19 V). Crss(800 V) understates the low-voltage Cgd: confirm by DPT."
		(exclude_from_sim no)
		(at 14 36.5 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "1bdddd9b-8b00-5f62-a383-e2f1db8633fb")
	)
