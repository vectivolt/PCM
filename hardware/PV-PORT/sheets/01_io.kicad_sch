	(text "PORT CONNECTOR (CTRL-C2000) + ID WITH HOLD READBACK"
		(exclude_from_sim no)
		(at 14 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "3dd5db76-b302-5871-80fa-82f557d47852")
	)
	(text "port.CTRL_PINS: DO1-DO8 (DO_SPARE = proof test), FB_A + its GND, FB_B +\nits GND (INT-02), 2 coil returns. Port B (battery) drives 2 HVC43 coils:\nK_B_MAIN up to 0.60 A -> SYS DO4 needs ILIM 10 k (1.58-2.30 A)."
		(exclude_from_sim no)
		(at 125.168 77.06 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "8ac6d136-0e00-5761-ae26-4332742c0409")
	)
	(text "CONTROL CONNECTOR (SYS-IO-AUX)"
		(exclude_from_sim no)
		(at 125.168 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "9dcd7564-d870-5f3d-892d-f846bde2788f")
	)
	(text "LMR36015 400 kHz, 24 V -> 3.315 V (100 k / 43.2 k, SNVSB49D sec 10.2), <= 0.34 A for\n6 x AMC3330 + 2 x AMC3302 + hold logic. AGND joins GND only here (0 ohm)."
		(exclude_from_sim no)
		(at 220.168 80.48 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "ae00360b-e700-516c-9402-8b65f4ef925f")
	)
	(text "interfaces.PORT, ribbon 1:1. AMC outputs drive the cable directly (<= 500 pF, AMC3330 p4); anti-alias RC\nis on CTRL-C2000. ID: 28k || readback network = 9.99 k (PV-PORT code 10.0k; CTRL-C2000 rev D values). RB\noutputs through 2 x 118k (port A) and 2 x 42.2k (port B): nine states, >= 155 counts apart (81 with the hold\ncoils on, sim/port_design.py sec. 7.4); CTRL decodes them with its port-only table."
		(exclude_from_sim no)
		(at 14 110.68 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "db4962eb-0dbf-5470-a8b1-1f8ba5a612ef")
	)
	(text "SENSOR SUPPLY +3V3S"
