	(text "10.0k / 13.0k: a sensor output up to its 5.25 V supply reads <= 3.0 V; 1 nF C0G charge bucket."
		(exclude_from_sim no)
		(at 269.894 57.08 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "148e6b81-42ef-5516-b931-06e10b11e4ac")
	)
	(text "NTC9: Murata NCP15 on PCS-PWR, 10.0k from VREF + 100 nF here. TMUX1208: S1-S8 = NTC1-8 (each keeps\nits 100 nF and its hardware OT / open-probe comparators, sheet 04) -> NTC_MUX, one ADC pin; A0-A2 from\nGPIO58-60 with 100k pull-downs, EN high. Firmware converts >= 5 ms after an address change."
		(exclude_from_sim no)
		(at 14 149.824 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "23b2435c-bc22-520f-8f58-6c916ea2f819")
	)
	(text "VGN = the N terminal of PCS-PWR-4W (left open by the three-wire PCS-PWR). K_AC2 = K_AC2_M AND HEALTHY: a trip\nopens AC contactor 2 as AC contactor 1. RCM_TST straight from GPIO21 (100k pull-down on PCS-PWR: open = no test current)."
		(exclude_from_sim no)
		(at 14 58.82 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "2cb91f3d-7141-50d1-ab64-e8d375328c74")
	)
	(text "NTC9 (DC-LINK BANK) AND THE NTC MUX"
		(exclude_from_sim no)
		(at 14 96.844 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "30ef2b31-06d0-501d-840c-cb09c21c1a15")
	)
