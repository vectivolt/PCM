	(text "SERVICE F-RAM"
		(exclude_from_sim no)
		(at 14 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "3b35fb0a-70f7-5305-813c-6974354b18c6")
	)
	(text "64 kbit F-RAM, 1e14 write cycles: an hours counter written every minute for\n20 years is ~1e7 writes. WP low (writable). I2C pull-ups and the 0x57 EEPROM are on CTRL."
		(exclude_from_sim no)
		(at 14 56.4 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "60fd6826-577e-5017-b126-0e9834929adc")
	)
	(text "BOARD TEMPERATURE"
		(exclude_from_sim no)
		(at 141.112 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "63fd193f-f608-563e-b393-ebb6c48b4df4")
	)
	(text "EXPANDER 1 (ADDRESS 0): OUTPUT-DRIVER AND FAN FAULTS"
		(exclude_from_sim no)
		(at 283.92 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "6bb5b753-f1b6-5e2a-9688-b01d1b11e749")
	)
	(text "GPA0-7 = DO1-8 FLT (TPS272C45D), GPB0-3 = fan eFuse FLT, GPB4 = FAN_EN out, GPB5 = TMP ALERT,\nGPB6 = OV_CUT readback, GPB7 = +24V eFuse FLT. Inputs: enable GPPU pull-ups. Reset = SYS_RST_N.\nMCP23S17 at 3.3 V is rated -40..+85 C (DS20001952C p1; +125 C only at 4.5-5.5 V): enough for PV-20."
		(exclude_from_sim no)
		(at 283.92 87.22 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "76afa87c-dd8b-5e82-94fd-2f019c1c4384")
	)
	(text "EXPANDER 2 (ADDRESS 1): CHAIN SELF-TEST AND SWITCH READBACK"
		(exclude_from_sim no)
		(at 14 99.72 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a0933b65-d49e-564a-b846-ed3611b04619")
	)
	(text "GPA0-2 = DOS A / DOS B / GD eFuse FLT, GPA3-5 = 24V_DO_MID / 24V_DO / +24V_GD present (100k/15k:\n21.6 V -> 2.82 V; surge 3.93 V, clamp < 0.1 mA), GPA6/7 = TEST_A_N / TEST_B_N outputs (10k pull-ups: idle healthy;\ndriving low can only trip a channel), GPB0/1 = UV_OK / TRIP_OK readback via 100k, GPB2/3 = UV_TEST /\nTRIP_TEST outputs (100k pull-downs: idle off; high forces that detector input into its trip state),\nGPB4 = SVC_RB (service jumper fitted = 0), GPB5 = AUX_INH_RB (0 = AUX-HV is the source, power outputs\ninhibited), GPB6 = AUX_TEST output (100k pull-down; high forces the inhibit), GPB7 spare (enable GPPU)."
		(exclude_from_sim no)
		(at 14 208.16 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "d3de225d-8f6b-5840-b6c5-9be86e55fcf5")
	)
	(text "TMP1075 at 0x48 (no clash with 0x50 / 0x57); ALERT -> expander 1 GPB5."
		(exclude_from_sim no)
		(at 141.112 58.34 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "e1d9bf21-4260-5bdc-907c-8405c34682eb")
	)
