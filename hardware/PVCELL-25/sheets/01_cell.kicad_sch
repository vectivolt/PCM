	)
	(text "Ribbon 1:1 to a CTRL-C2000 cell port. AN2_N/AN3_N = AGND here (single-ended 0-2.5 V, AN_N tied at the\nsource per the CTRL AFE). NTC_P/N float to the second heatsink NTC (biased on CTRL). PWM5-8 unused:\n120R only. +24V: 0.52 A of 1.0 A worst case (design_check); <= 600 uF on the rail."
		(exclude_from_sim no)
		(at 14 127.412 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "273a7ce8-44ad-5483-958d-76b8157211bd")
	)
