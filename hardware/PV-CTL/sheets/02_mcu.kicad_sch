	(text "Every MCU output that ends in an AND gate here is low while the MCU is in reset or unprogrammed (GPIOs\nhigh impedance): 16 PWM, EN, K_A, K_B, K_PRE, STATUS, FAN_PWM, HEARTBEAT (23 lines, 1 spare element).\nBIAS_EN, IMD_SW1/2 go straight to PC: pulled down on the power board (10k / 100k, PV-PWR)."
		(exclude_from_sim no)
		(at 474.874 160.06 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "1d63adb0-b52d-548a-a373-bf381a7860b2")
	)
	(text "JTAG CTI-20 - HAZARDOUS LIVE (ISOLATED PROBE ONLY)"
		(exclude_from_sim no)
		(at 150.76 111.96 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "2460516d-80e1-5223-86fe-ae0e943a98d7")
	)
	(text "Green, GPIO34 low = on (firmware heartbeat), 680 R: ~2 mA."
		(exclude_from_sim no)
		(at 14 210.22 0)
		(effects
