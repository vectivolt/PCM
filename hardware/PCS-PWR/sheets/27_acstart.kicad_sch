	(text "K_ACPRE = PCS_PC PWM16, gated by the trip latch on the control board; logic lost = coil off."
		(exclude_from_sim no)
		(at 173.41 124.64 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "18ec236a-b2c5-5fe0-9efb-5c9d95259d51")
	)
	(text "The tap's + rail feeds the aux through its own BYG10Y: the aux runs from the grid with the DC side dead\n(565-650 V rectified at 400-460 V AC, inside its 250 V..1000 V full-power range)."
		(exclude_from_sim no)
		(at 182.59 40.64 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "1b872f56-6398-5b10-ba91-3b12908d8c88")
	)
	(text "GRID TAP (LIVE DOMAIN: THE LOWER DIODES TIE DC- TO THE GRID PHASES; BASIC OVC III TO PE AS THE AC SIDE)"
		(exclude_from_sim no)
		(at 14 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "2262e86a-479f-50a9-a6a7-77796ffe1702")
	)
	(text "COIL DRIVER (PORT._LEAN_DRV) FROM K_ACPRE"
		(exclude_from_sim no)
		(at 173.41 75.42 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "30ab85b5-8104-551c-b188-1c6e828a7daf")
	)
	(text "Per phase from K2O_x (grid side of K1 / K2, works with the contactors open; behind the CM choke and the AC SPD):\nAC10 20 ohm (inrush, surge and fault limit ahead of the fuse) -> ABB-A 1.60 (1.6 A, 500 V AC, 200 A interrupting) -> bridge."
		(exclude_from_sim no)
		(at 14 62.92 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "3139c5c8-a3b2-5a3c-b2a4-9daffb24ff80")
	)
	(text "AC PRECHARGE: G7L-2A-X (DC, POLES IN SERIES, NORMAL POLARITY) + 220 OHM RPRE_AL FROM ACT_P TO DC+"
		(exclude_from_sim no)
		(at 14 75.42 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "356232fd-c699-51e7-877b-346edbd4eb07")
	)
	(text "Charges the DC link to the line-to-line peak through the tap with the main contactors open (pcs_spec ac_start);\nfirmware interlocks: K_ACPRE only with K_B, K_PRE, K_A, K_AC2 open; abort / retry / welded-relay rules."
		(exclude_from_sim no)
		(at 14 110.16 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "b29c58ba-551d-53f3-b35d-8863c237cad9")
	)
