	(text "NEUTRAL LEG: L_N (CHASSIS, CUSTOM, THE L1 PART) AND ITS STUDS"
		(exclude_from_sim no)
		(at 14 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "30c3f05e-c3ee-5350-88e5-f53073d17165")
	)
	(text "C_fN = 2 x 25 uF MKP (50 uF) + R_d 2 ohm / C_d 10 uF, N_F to M: the N leg's 62 A pp carrier ripple returns\nlocally (4.8 V pp on C_fN at 950 V); the N leg holds v(N_F - M) at 0 (mode A) or the phases' zero sequence (mode B)."
		(exclude_from_sim no)
		(at 270.336 53.304 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "3571470f-0c7f-5f54-81a0-d7900a875f16")
	)
	(text "NEUTRAL FILTER NODE: C_FN AND DAMPING BRANCH TO M"
		(exclude_from_sim no)
		(at 270.336 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "57d9d3f4-2456-547c-a074-6942ea3333d5")
	)
	(text "IL4 = Uref + 3.2 mV/A x I_N (I + = L_N -> N_F), IL4R = its Uref pin; 100R + 1 nF each at the source (as the phases).\nThe control board's IL4 window and CMPSS4 (four-wire assembly) guard the N leg like a phase."
		(exclude_from_sim no)
		(at 149.272 68.192 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "84ec696c-0d06-5180-947d-bc758401fc4d")
	)
	(text "Board studs (REDCUBE press-fit, 100 A each): 3 x switch node to L_N, 3 x L_N out (N_F, its busbar through the sensor),\n3 x N_F to the N pole of K1 (port sheet). L_N's winding NTC = NTC8; core bonded to PE."
		(exclude_from_sim no)
		(at 14 64.88 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "d6e2cf94-841a-5e00-8646-a8c9f99d90a3")
	)
