	)
	(text "One tap per port (+ pole, terminal side), return = BUS-:\n2 x 20R R pulse-rated ahead of the 1 A / 1000 VDC fuse, BYG10Y OR;\n2 x 3.3 uF / 1300 V film = surge absorber (AUX-HV rev C1 input block)"
		(exclude_from_sim no)
		(at 118.5 274 0)
