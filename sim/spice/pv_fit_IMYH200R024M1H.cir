* PVCELL VDMOS C_gd fit for IMYH200R024M1H: drain ramp 0..1200 V, gate held at -3.0 V
.model m VDMOS(Vto=4.5 Kp=5 lambda=0.01 Rd=0.008185 Rs=0.5m Rg=6.0 Cgs=4.839e-09 Cgdmax=9.7e-10 Cgdmin=1.1e-11 a=0.2447 Cjo=3.004e-09 Vj=3 M=0.5 Is=7.58e-16 N=3 Rb=0.01285 Tt=0)
Vg g 0 -3.0
Vd dd 0 PWL(0 0 10u 1200.0)
Rd dd dn 1m
M1 dn g 0 m
.save i(Vg) v(dn)
.tran 5n 10u
.control
run
wrdata pv_fit_IMYH200R024M1H.dat i(Vg) v(dn)
quit
.endc
.end
