	(text "AUX-T1 reinforced winding SELV_24V / SELV_0V, cross-regulated 20.3-29.8 V (aux75_spec); full fan speed needs\n24.5 V. Full fan speed is only guaranteed while the converter is switching. Fan buck (12-36 V in) + SELV logic on the control board;\n>= 10 mm from live copper; nothing else of the SELV domain is on this board."
		(exclude_from_sim no)
		(at 14 260.22 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "2e4199f6-1d2d-578d-b994-31a9396baefe")
	)
	(text "gate bias of phases 3 only. ctrl_c2000 circuit (SNVSC40E table 9-1, 400 kHz / 5 V / 2 A): 15 uH, 3 x 22 uF, RT 64.9k,\nFB 100k / 24.9k 0.1 % -> 4.93-5.10 V. Load in design_check (<= 80 % of 2 A)."
		(exclude_from_sim no)
		(at 14 157.58 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "3799084a-d72c-52ed-be26-a71640ff097b")
	)
	(text "EN = PG_5VG. FB 31.6k / 10k 0.1 % -> 3.240-3.433 V (>= 3.20 V for the control board's reference). SS/TR 470p C0G:\nramp-up 12-16 mV/us (F28003x VDDIO 8-100 mV/us). Ports' logic, RDY / MOV_OK pull-ups, PC +3V3 (control <= 157 mA)."
		(exclude_from_sim no)
		(at 14 225.14 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "3d0bf8e8-f71b-5e58-97aa-9fc97064afc2")
	)
	(text "+5V_GD -> +3V3 (TPS62130, 2.5 MHZ) WITH A CONTROLLED RAMP"
		(exclude_from_sim no)
		(at 14 170.08 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "645c503d-a540-59ab-91ca-62951f3e2b8b")
	)
	(text "24 V -> +5V_GD (LMR38020, 400 KHZ, 2 A)"
		(exclude_from_sim no)
		(at 14 98.12 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "7de72c0a-aa21-5edf-a2ed-34cbc3a8c5b9")
	)
	(text "TPS3710 107k/10k as on +5V: RDY low while the bias rail of phases 3 is below 4.52-4.69 V."
		(exclude_from_sim no)
		(at 209.42 146.612 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "9244ad67-9a77-5dc6-a2ec-e894fb3869f6")
	)
	(text "NSI6651 inputs, AHCT, sensors, references, PC +5V, gate bias of phases 1-2. ctrl_c2000 circuit (SNVSC40E table 9-1, 400 kHz / 5 V / 2 A): 15 uH, 3 x 22 uF, RT 64.9k,\nFB 100k / 24.9k 0.1 % -> 4.93-5.10 V. Load in design_check (<= 80 % of 2 A)."
		(exclude_from_sim no)
		(at 14 85.62 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "a96fafa9-4533-5ae4-b243-0f725807235c")
	)
	(text "+5V_GD SUPERVISOR ON RDY"
