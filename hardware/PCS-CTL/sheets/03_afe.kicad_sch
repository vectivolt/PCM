	(text "3.0 V REFERENCE (REF3030E FROM +3V3A)"
		(exclude_from_sim no)
		(at 14 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "08c8c36f-c7e5-541d-abd7-e6a93b14c07c")
	)
	(text "VA/VB/VAX/VBX/VPE = VMID + V/1203; IA/IB = VMID + 3.0 mV/A (+/-478 A); IA_H/IB_H = VMID + 1.0 mV/A.\nAnti-alias poles are on the power board; here 100 R / 1 nF C0G as the ADC charge bucket. The trip\ncomparators take the PC net itself (no ADC kick-back on them)."
		(exclude_from_sim no)
		(at 459.176 85.184 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "09e43f33-7bd7-5efe-b0a4-a5b8618e42c8")
	)
	(text "INLET-AIR NTC (ON BOARD)"
		(exclude_from_sim no)
		(at 270.376 116.932 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1eb47bad-2998-543c-b0e5-7fe1a3570ccf")
	)
	(text "NTC INPUTS (10 K B25/100 3988 K TO AGND + 100 NF ON PV-PWR, BIASED HERE FROM VREF)"
		(exclude_from_sim no)
		(at 14 116.932 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1fb390e0-d41d-5677-80e0-94b4e59e07e5")
	)
	(text "ILn = 2.5 V + 10.667 mV/A (STK-HO/A 75 on PV-PWR, 0.5-4.5 V, not ratiometric) -> 10.0k / 29.4k 0.1 %\n-> ILn_P (47 pF, a = 0.746): trip window (sheet 04) and the + input; Rg 36.5k to VREF, Rf 10.0k: ADC =\n1.555 V + 10.14 mV/A (0.072 A/LSB, -153..+142 A) -> 47 R / 1 nF -> ADC + CMPSS. IL4 = 0 V on PV-P75."
		(exclude_from_sim no)
		(at 142.984 104.432 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "34fffbe0-33c7-5f56-95fb-43123bc6018d")
	)
	(text "NTC1-4 heatsink sections (10.0k), NTC5-8 inductor windings (4.99k), 100 nF each. Open probe = 3.0 V:\ntrips through the open-probe comparators (sheet 04); short = 0 V: trips as over-temperature."
		(exclude_from_sim no)
		(at 14 183.552 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "4478ce44-1963-56ce-b6dd-c34461411bea")
	)
	(text "INDUCTOR-CURRENT FRONT ENDS IL1-IL4 (TLV9064 GAIN STAGES)"
		(exclude_from_sim no)
		(at 142.984 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "61829815-4738-574c-a10f-a3c094b5a73e")
	)
