* DAB-D60 switching-level SPS deck "cal_800_900_600" - generated by sim/dab_design.py, do not edit
* V1=800 V V2=900 V n=0.9167 L=6.500 uH Lm=150 uH phi=24.648 deg tdead=150 ns Ron=7.86 mohm
* snubber per bridge 6 x (6.8 ohm + 2.20 nF); HF ceramics 10 x 47 nF
.subckt sic d s g cq=1n
Bch d s I='(250*V(g)+1e-6)*tanh(V(d,s)/(0.00786*(250*V(g)+1e-6))) + V(d,s)*1e-8'
D1 s d dbody
Cq d s {cq}
.ends sic
.model dbody d(is=1e-9 n=5 rs=0.025)
Vp1 p1 0 DC 800
Vs1 p1 p1a 0
Rs1 p1a k1 1m
