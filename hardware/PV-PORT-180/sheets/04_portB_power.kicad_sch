	(text "MAIN CONTACTOR: COIL DRIVE + FEEDBACK"
		(exclude_from_sim no)
		(at 594.0748 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "03a09035-3729-513b-aff9-2839eac9900a")
	)
	(text "FB_B_MAIN (SYS DI) = BOTH contactors closed: own 1.5 k pull-up, a BAS16 to each mirror node, so a\ncontactor that failed to close is seen at once (the single-contactor state is not coordinated). The hold\nlogic and the TPSI3050 EN use B_FB_ANY = ANY closed (BAS16 diode-OR): a single welded contactor still inhibits\nthe discharge and arms the hold; firmware finds a single weld by VA vs VAX. K_B_MAIN: 0.60 A (2 coils)."
		(exclude_from_sim no)
		(at 14 215.624 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "043ec3f7-0f28-5cc1-bc0a-407c32fe8ecd")
	)
	(text "PRECHARGE RELAY + RESISTOR"
		(exclude_from_sim no)
		(at 453.164 167.064 0)
		(effects
