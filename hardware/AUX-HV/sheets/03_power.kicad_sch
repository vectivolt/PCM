	(text "SOFT START AND COMP"
		(exclude_from_sim no)
		(at 14 115.344 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "59024da5-825b-51fe-b64d-8ebc488ccdb3")
	)
	(text "foldback: switched onto RT/CT below 7.7-10.1 V output -> fsw 5.9 kHz (5.3-6.8).\nAux plateau -> US1G -> 4.7k -> 470p || 22k -> BZX84-B6V8 -> Q_INV: aux healthy holds FBK low;\nshort: FBK -> VREF via 47k, Q_FB connects C_TX. aux-plateau detector charge (tau 1.8 us, rejects the clamp spike)."
		(exclude_from_sim no)
		(at 257.008 102.844 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "5bd209e0-12b4-5a90-b1c3-6619d1c2412b")
	)
	(text "COMP = opto collector + 2.2k pull-up + EA source; BAT54S clamps COMP to the soft-start\nnode (100k, 2.2u) and discharges it into VREF in UVLO."
		(exclude_from_sim no)
		(at 14 173.574 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "61e17aaa-0f3f-5aaa-8d4a-2e5e3251236f")
	)
	(text "SIC SWITCH AND CURRENT SENSE"
		(exclude_from_sim no)
		(at 268.6414 115.344 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "94375a6e-a933-5550-9625-7179917a5dac")
	)
	(text "Na > Ns: the aux takes VDD over at 14.5 V output, below the\n16.1 V SYS eFuse UVLO. follower Zener bias: VDD = gate drive 15.46-18.11 V (BZX84-A18, -40..85 C). backup loop: Vout 23.82-30.97 V if the opto loop fails.\nAX-05: BAT54 leakage sink, V_EB 0.4 V at 85 C / 3.3 V at 125 C (< 5 V)."
		(exclude_from_sim no)
		(at 112.696 193.064 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "9db0b5c1-424d-5b51-b6dc-89ccab25a20d")
	)
	(text "AUX WINDING: VDD FOLLOWER, BACKUP OVER-VOLTAGE LOOP"
		(exclude_from_sim no)
		(at 112.696 115.344 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "9e1dfb9f-4e41-5176-a093-ab4f0d46e64c")
	)
	(text "Dots at the winding starts PS, AS, SS. Np/Ns/Na 90/15/16, Lp 1.148 mH.\nFull winding and insulation specification in the T1 description field."
		(exclude_from_sim no)
		(at 118.546 245.384 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "b5bfcc76-b682-5901-8712-ebdaf450acc7")
	)
	(text "PWM CONTROLLER"
		(exclude_from_sim no)
		(at 14 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "cc55d177-375f-50a2-9cdd-876a149db88b")
	)
	(text "Kelvin source (pin 2) on the sense node. 2 in parallel = 0.750 R: limit 1.19-1.48 A (+0.26 A delay).\nCS RC filter 1k / 150p (no internal blanking)."
		(exclude_from_sim no)
		(at 268.6414 180.484 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "dcd3d727-36d7-52fa-b740-fcfdf0ed8d78")
	)
	(text "oscillator 129.8 kHz -> fsw 64.9 kHz (58.3-74.2). VDD 56 uF effective: VDD hold-up 17.6 ms.\nUVLO 16/12.5 V (SiC), duty < 48 %, no slope compensation needed (DCM, D < 0.5)."
		(exclude_from_sim no)
		(at 14 85.72 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "dd4008fb-a3a4-5b5e-bf2b-c2e85946aac0")
	)
