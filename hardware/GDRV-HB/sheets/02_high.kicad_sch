	(text "DESAT > 10.3-10.9 V (above the 9.8 V maximum trip) -> MMBT3904 -> MMBT3906 charges BG to VEE + 10 V;\nper device AO3400A + 15R pull the gate to VEE; BG holds ~3 us (1k + FET gates)."
		(exclude_from_sim no)
		(at 159.592 215.952 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "b8df1246-7d4d-5fea-bf23-98f4cabb6a52")
	)
	(text "NSI6651ASC CLAMP direct to the gate (active Miller clamp). Kelvin = COM.\nZener pair clamps the gate to about +17 V / -6.6 V when the driver cannot."
		(exclude_from_sim no)
		(at 14 230.056 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "c2c82685-d101-53e3-a290-546e0f71ff31")
	)
	(text "UCC14241-Q1, 24 V in, regulated +/-1.3 %, reinforced barrier.\nRDR: RLIM1 sources COM, RLIM2 + DLIM sink it."
		(exclude_from_sim no)
		(at 187.533 131.108 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "f236e328-7e54-518c-be4c-12207256f660")
	)
	(text "DESAT pin (internal 500 uA blanking source, trip 8.5-9.8 V) - Rs - 3 x US1M - drain.\nBAT54S keeps DX between COM and VDD against dv/dt through the string; Cblk footprint DNP."
		(exclude_from_sim no)
		(at 263.192 198.928 0)
		(effects
			(font
