	)
	(text "LAYOUT: loop <= 20 nH, bank <= 15 nH from each leg, damper loop <= 3 nH, clamp branch <= 1.5 nH, Miller clamp loop <= 1 nH, drain-pin slot. BENCH: Miller margin 0.53 V, LA 150-P dv/dt, damper power, pad PD test."
		(exclude_from_sim no)
		(at 20 252 0)
