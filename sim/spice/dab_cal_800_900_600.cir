Csn1 sn1 0 1.32e-08
Lhf1 bt1 hf1 1e-10
Rhf1 hf1 hc1 0.001
Chf1 hc1 0 4.7e-07
XS1 bp1 na g1 sic cq=9.6202e-10
XS2 na 0 g2 sic cq=9.6202e-10
XS3 bp1 nb g2 sic cq=9.6202e-10
XS4 nb 0 g1 sic cq=9.6202e-10
Vil na na1 0
Lk na1 nx 6.5e-06 IC=-77.2839
Lmag nx nb 0.00015 IC=-9.98436
Etr nx nxb nc nd 0.916667
Vtr nxb nb 0
Ftr nd nc Vtr 0.916667
Rg s0 0 1meg
Vp2 p2 s0 DC 900
Vs2 k2 p2a 0
Rs2 p2a p2 1m
Rk2 k2 kr2 0.0008667
Lk2 kr2 kc2 6.333e-09
Ck2 kc2 s0 0.000195
Lb2 k2 bt2 7.2e-09
Lm2 bt2 bp2 1.5e-08
Rsn2 bt2 sn2 1.13333
Csn2 sn2 s0 1.32e-08
Lhf2 bt2 hf2 1e-10
Rhf2 hf2 hc2 0.001
Chf2 hc2 s0 4.7e-07
XS5 bp2 nc g5 sic cq=9.1336e-10
XS6 nc s0 g6 sic cq=9.1336e-10
XS7 bp2 nd g6 sic cq=9.1336e-10
XS8 nd s0 g5 sic cq=9.1336e-10
Vg1 g1 0 PULSE(0 1 2e-07 2.5e-08 2.5e-08 4.824e-06 1e-05)
Vg2 g2 0 PULSE(1 0 5e-08 2.5e-08 2.5e-08 5.125e-06 1e-05)
Vg5 g5 0 PULSE(0 1 8.84661e-07 2.5e-08 2.5e-08 4.824e-06 1e-05)
Vg6 g6 0 PULSE(1 0 7.34661e-07 2.5e-08 2.5e-08 5.125e-06 1e-05)
.ic V(k1)=800 V(bt1)=800 V(bp1)=800 V(sn1)=800 V(p1a)=800 V(na)=0 V(nb)=800 V(k2)=900 V(bt2)=900 V(bp2)=900 V(sn2)=900 V(p2a)=900 V(nc)=0 V(nd)=900 V(nx)=-25 V(hf1)=800 V(hc1)=800 V(hf2)=900 V(hc2)=900 V(kr1)=800 V(kc1)=800 V(kr2)=900 V(kc2)=900
.options method=gear reltol=1e-3 abstol=1e-6 vntol=1e-4 chgtol=1e-15 itl4=100
.tran 1e-09 0.00024 0.00019 1e-09 uic
.control
run
wrdata sim/out/dab_design/spice_cal_800_900_600.txt i(Vil) V(na,nb) V(nc,nd) V(bp1,na) V(na) V(bp2,nc) V(nc) i(Vs1) i(Vs2) V(g1) V(g5) V(bp1) V(bt1,sn1) V(bt2,sn2) V(bp2,s0) V(bt1) V(bt2,s0) V(hf1,hc1) V(hf2,hc2)
