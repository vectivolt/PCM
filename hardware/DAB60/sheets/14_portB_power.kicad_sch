	(text "G7L-2A-X, poles in series, normal polarity = current 8 -> 2 (terminal -> bus). K_B_PRE feeds the coil\nand gates its IRFL214 low side; S2M + SMBJ33A across the coil (37-42 V, Omron p5). R_pre 220 ohm Miba\nRST 200 (RFQ, pulse-rated). Complete at |dV| <= 10 V after the VA/VAX null; abort below 0.8 x Vterm x\n(1-exp(-t/0.22 s)) or at 1.32 s; max 3 attempts, then 30 s lock-out (sim/port_design.py)."
		(exclude_from_sim no)
		(at 14 230.164 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "0fcdf8b7-ab42-5747-ae5a-7485e2ffc66d")
	)
	(text "MAIN CONTACTOR: COIL DRIVE + FEEDBACK"
		(exclude_from_sim no)
		(at 363.676 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "13659b8a-fb2e-5adc-867a-99cff26b96e4")
	)
	(text "PASSIVE BLEEDER + BOARD CONNECTION POINTS"
		(exclude_from_sim no)
		(at 176.06 257.844 0)
		(effects
