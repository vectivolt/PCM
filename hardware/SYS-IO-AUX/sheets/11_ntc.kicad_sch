				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "7374d1aa-c703-5aa2-a669-f8512ed370ae")
	)
	(text "ADS7953: +VA 5 V, +VBD 3.3 V, range 1 (0..VREF, GPIO2 pulled low), MXO -> AINP.\nGPIO0/1/3 inputs by default, pulled low. SDO tri-states when CS is high."
		(exclude_from_sim no)
		(at 14 121.28 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "99426aa7-3f3b-58c4-b55b-edf844a63f1e")
	)
