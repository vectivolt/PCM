	)
	(text "B_TERM+/- (250 A), X 2.2 uF 1300 V across the port, Y1 4.7 nF pole - PE_T (removable PE link for the hipot).\nBoard taps B_IN+ / B_IN- by short links."
		(exclude_from_sim no)
		(at 14 83.204 0)
		(effects
