	(text "LED_0 = link, LED_1 = activity (register-configured): 2.49k parallel pull-ups (7.5.2) keep both straps\nat mode 4 and make the LEDs active-low; SYS sinks its LED current into these pins.\nRESET_N: internal pull-up 6.75-11.25 k, so 1.0k holds it at <= 0.43 V < VIL 0.8 V while GPIO119 floats\n(CSR-06); firmware pulses it low >= 10 us after the clock is stable. XI 10k pull-down (9.2.2.1.1.1)."
		(exclude_from_sim no)
		(at 14 100.38 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "277b6f7e-ed9d-5f52-97a7-ee8b217e6c16")
	)
