	)
	(text "TMS 2.2k pull-up and TRSTn 2.2k pull-down (SPRSP14E table 6-1); TDIS to GND; VTRef via 100 R;\nRTCK looped to TCK; EMU0/1 4.7k pull-ups (no EMU pins on F2838x); RESET (open drain) on XRSn;\nEMU2-EMU4 (17-19) grounded as SPRSP14E 7.10.7 requires (CSR-07)."
		(exclude_from_sim no)
