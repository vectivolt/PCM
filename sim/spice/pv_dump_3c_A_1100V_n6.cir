Lleg l1 bp 1.5e-08
Dcl 0 k1 dcl
Lcl k1 bp 1e-09
.save v(c1) v(bp) i(Lm) i(Lesl) i(Vsl) v(l1) i(Lcl) v(k1)
.tran 8.64e-09 0.003456 0 2e-08 uic
.options method=gear maxord=2 reltol=2e-3 abstol=1e-6
.control
run
linearize v(c1) v(bp) i(Lm) i(Lesl) i(Vsl) v(l1) i(Lcl) v(k1)
wrdata pv_dump_3c_A_1100V_n6.dat v(c1) v(bp) i(Lm) i(Lesl) i(Vsl) v(l1) i(Lcl) v(k1)
quit
.endc
.end
