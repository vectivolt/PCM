		(exclude_from_sim no)
		(at 14 19 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "e30621f1-d79d-5ae2-bde3-fc1aa911dd59")
	)
	(text "SN6505B push-pull 420 kHz from +5V, BIAS_EN high = on; T_BIAS4 custom, functional insulation\n(PD-free >= 1.75 kVpk, <= 5 pF per secondary). Per channel: bridge, PNP regulator VDD-VEE, ATL431 COM split."
		(exclude_from_sim no)
		(at 109 276.856 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
