	)
	(text "NTC: B57703M0103 (10k, B 3988). VREF 2.5 V -> 10k 0.1 % -> NTC; 1k + 100n -> ADC (ratiometric).\nCodes (12 bit): -40 C 3978, 25 C 2048, 125 C 135, 150 C 74. Open > 4040, short < 40:\nboth are outside the -40..150 C band, so a broken or shorted sensor is distinguishable."
		(exclude_from_sim no)
		(at 241.144 118.82 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "6e66b0df-ef33-5e60-8fba-babfe9c90638")
	)
	(text "NTC6-NTC10"
